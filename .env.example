# ==== Telegram ====
# Приложение аккаунта: https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# Строковая сессия. Получить: python make_session.py --window
SESSION_STRING=

# ==== Управление кнопками (твой бот @bot_post_sam_bot) ====
# Ключ бота из @BotFather. Ввести так, чтобы он не попал в чат:
# python make_session.py --token --window
# Пусто - кнопок не будет, управление останется командами в группе.
BOT_TOKEN=
# Дополнительные id, которым можно нажимать кнопки (через запятую).
# Владелец аккаунта из SESSION_STRING может всегда, здесь можно оставить пусто.
PANEL_ADMINS=

# ==== Нейросеть (MiniMax) ====
# Ключ: https://platform.minimax.io -> API Keys
# Пусто = нейросети нет, посты выходят словами автора (это рабочий режим, не ошибка).
MINIMAX_API_KEY=
# MiniMax-M3 (качественнее) или MiniMax-M3.1-Flash (дешевле и быстрее)
AI_MODEL=MiniMax-M3
# disabled = просить модель НЕ рассуждать вслух (иначе её монолог попадает в пост).
# adaptive - оставить reasoning, но бот всё равно вырежет его из ответа.
AI_THINKING=disabled
# Переписывать ли посты по умолчанию. 0 = по умолчанию публикуем словами автора.
# У каждого канала и у каждого клиента кабинета это включается/выключается своей кнопкой.
REWRITE=1
AI_MAX_TOKENS=2000
AI_TIMEOUT=90
AI_RETRIES=3
AI_RETRY_DELAY=5
# Адрес API. Для китайского аккаунта: https://api.minimaxi.com/v1/chat/completions
MINIMAX_API_URL=https://api.minimax.io/v1/chat/completions
# Свой текст промпта, если стандартный не устроит
# AI_SYSTEM_PROMPT=

# ==== Каналы: куда постить и откуда брать посты ====
# Список живёт в группе с темами: тема = твой канал, ссылки внутри темы = каналы,
# откуда берём посты. Группу создаёт кнопка «🏛 Создать группу» в боте,
# заполняют её те же кнопки - руками в группе ничего писать не нужно.
# Оставь пустым - после перезапуска бот найдёт свою группу сам (аккаунт в ней владелец).
MANAGEMENT_CHAT=
# Сколько последних сообщений читать в каждой теме при сборке списка
HISTORY_LIMIT=200

# ==== Продвижение (Lucky Up) ====
# Адрес бота: https://t.me/LuckyUpbot
PROMO_BOT=@LuckyUpbot
# Шаг 1: какую кнопку нажать в боте, чтобы он попросил пост (пусто = не нажимать)
PROMO_BUTTON=Просмотры
# Шаг 3: сколько просмотров добавить к каждому посту, число (0 = не отправлять).
# Это только значение по умолчанию для НОВЫХ каналов: на экране канала есть «👁 Просмотры на пост» — там своё число для каждого канала, оно живёт в теме канала в группе и переживает перезапуск.
PROMO_VIEWS=4100
# Сколько секунд ждать между шагами: нажатие -> пересылка -> число -> ответ бота
PROMO_DELAY=3

# ==== Бесплатные реакции (smmnakrutka.ru) ====
# Бот сам ждёт 5 минут, получает у сервиса разрешение и отправляет ссылку на пост.
# 0 = не заказывать реакции совсем. Для каждого канала — кнопка «🎭 Реакции: ставим / не ставим» на его экране.
REACTIONS=1
# Пауза между пробами в секундах. Страница сервиса говорит «подождите 5 минут», правила — «один заказ в час».
# Ставим 300 (5 минут); если сервис ответит отказом про лимит или час, бот сам сделает паузу до часа.
REACTIONS_INTERVAL=300
# Почта для уведомления сервиса (поле на сайте необязательное, можно пусто)
REACTIONS_EMAIL=
# Сколько секунд ждать ответа сервиса
REACTIONS_TIMEOUT=30

# ==== Кабинеты клиентов ====
# Адрес базы из Railway (в сервисе добавь PostgreSQL - он сам выдаст DATABASE_URL).
# Пусто = кабинетов нет, бот отвечает только владельцу аккаунта.
DATABASE_URL=
# Как показать клиенту рабочий аккаунт, который он добавит в администраторы своего канала.
WORKER_CONTACT=
# Что увидеть клиенту про оплату: карта, СБП по телефону - одной строкой.
PAYMENT_DETAILS=
# Цены и лимиты живут в коде: неделя 600 RUB, месяц 2000 RUB, 10 доноров, 50 постов в сутки.

# ==== Служебное ====
# Пауза, чтобы дождаться все карточки альбома (секунд)
ALBUM_WAIT=2
# Сколько id альбомов держать в памяти (защита от повторной обработки)
CACHE_SIZE=500
