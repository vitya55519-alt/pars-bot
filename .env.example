# ==== Telegram ====
# Приложение аккаунта: https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# Строковая сессия. Получить: python make_session.py --window
SESSION_STRING=

# ==== Нейросеть (MiniMax) ====
# Ключ: https://platform.minimax.io -> API Keys
MINIMAX_API_KEY=
# MiniMax-M3 (качественнее) или MiniMax-M3.1-Flash (дешевле и быстрее)
AI_MODEL=MiniMax-M3
# Глубина «размышления» модели: low | medium | high | xhigh | max
AI_REASONING_EFFORT=low
AI_MAX_TOKENS=2000
AI_TIMEOUT=90
AI_RETRIES=3
AI_RETRY_DELAY=5
# Адрес API. Для китайского аккаунта: https://api.minimaxi.com/v1/chat/completions
MINIMAX_API_URL=https://api.minimax.io/v1/chat/completions
# Свой текст промпта, если стандартный не устроит
# AI_SYSTEM_PROMPT=

# ==== Доноры и каналы ====
# Список живёт в группе с темами: тема = категория, название темы = твой канал,
# ссылки внутри темы = доноры. Свою группу с темами создай заранее.
# Оставь пустым - бот сам найдёт единственную группу с темами среди твоих чатов.
MANAGEMENT_CHAT=
# Сколько последних сообщений читать в каждой теме при сборке списка
HISTORY_LIMIT=200

# ==== Продвижение (Lucky Up) ====
# Адрес бота: https://t.me/LuckyUpbot
PROMO_BOT=@LuckyUpbot
# Шаг 1: какую кнопку нажать в боте, чтобы он попросил пост (пусто = не нажимать)
PROMO_BUTTON=Просмотры
# Шаг 3: сколько просмотров добавить к каждому посту, число (0 = не отправлять)
PROMO_VIEWS=4100
# Сколько секунд ждать между шагами: нажатие -> пересылка -> число -> ответ бота
PROMO_DELAY=3

# ==== Служебное ====
# Пауза, чтобы дождаться все карточки альбома (секунд)
ALBUM_WAIT=2
# Сколько id альбомов держать в памяти (защита от повторной обработки)
CACHE_SIZE=500
